          "path": "/teams",
          "body": {
            "id": "t-${run}",
            "name": "Idem"
          },
          "expect": {
            "status": 201
          }
        },
        {
          "as": "alice",
          "method": "PUT",
          "path": "/teams/t-${run}/members/carol",
          "expect": {
            "status": 200
          }
        },
        {
          "as": "alice",
          "method": "DELETE",
          "path": "/teams/t-${run}/members/carol",
          "expect": {
            "status": 204
          }
        },
        {
          "as": "alice",
          "method": "DELETE",
          "path": "/teams/t-${run}/members/carol",
          "expect": {
            "status": 204
          }
        },
        {
          "as": "alice",
          "method": "PUT",
          "path": "/teams/t-${run}/members/carol",
          "expect": {
            "status": 200
          }
        },
        {
          "as": "alice",
          "method": "PUT",
          "path": "/teams/t-${run}/members/carol",
          "expect": {
            "status": 200,
            "json": {
              "id": "carol",
              "role": "member"
            }
          }
        },
        {
          "as": "alice",
          "method": "GET",
          "path": "/teams/t-${run}/members",
