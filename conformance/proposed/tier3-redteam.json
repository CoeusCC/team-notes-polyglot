{
  "$comment": "PROPOSED, NOT RATIFIED (Grok, 2026-10-26). Tier 3 red-team asks: re-adding a removed member, and removal vs. a write by that member. Same data-only format as cases.json; cases reuse the existing ratified aliases TEAM-3/TEAM-4 and encode only what spec/openapi.yaml, ADR-0006 and the TEAM cards already determine. Do not merge into cases.json until Patrick decides. See conformance/proposed/tier3-redteam.md.",
  "tokens": {
    "alice": "tok_alice",
    "bob": "tok_bob",
    "carol": "tok_carol"
  },
  "cases": [
    {
      "id": "proposed-team-readd-restores-access",
      "falsifies": "NOTES-FUNC-TEAM-4",
      "steps": [
        {
          "as": "alice",
          "method": "POST",
          "path": "/teams",
          "body": {
            "id": "t-${run}",
            "name": "Readd"
          },
          "expect": {
            "status": 201
          }
        },
        {
          "as": "alice",
          "method": "PUT",
          "path": "/teams/t-${run}/members/carol",
          "expect": {
            "status": 200,
            "json": {
              "id": "carol",
              "role": "member"
            }
          }
        },
        {
          "as": "carol",
          "method": "POST",
          "path": "/teams/t-${run}/notes",
          "body": {
            "title": "carol before ${run}"
          },
          "expect": {
            "status": 201
          },
          "save": "mine"
        },
        {
          "as": "alice",
          "method": "DELETE",
          "path": "/teams/t-${run}/members/carol",
          "expect": {
            "status": 204
          }
        },
        {
          "as": "alice",
          "method": "POST",
          "path": "/teams/t-${run}/notes",
          "body": {
            "title": "while away ${run}"
          },
          "expect": {
            "status": 201
          },
          "save": "away"
        },
        {
          "as": "carol",
          "method": "GET",
          "path": "/notes/${mine.id}",
          "expect": {
            "status": 404
          }
        },
        {
          "as": "alice",
          "method": "PUT",
          "path": "/teams/t-${run}/members/carol",
          "expect": {
            "status": 200,
            "json": {
              "id": "carol",
              "role": "member"
            }
          }
        },
        {
          "as": "carol",
          "method": "GET",
          "path": "/notes/${mine.id}",
          "expect": {
            "status": 200,
            "json": {
              "authorId": "carol",
              "title": "carol before ${run}"
            }
          }
        },
        {
          "as": "carol",
          "method": "GET",
          "path": "/notes/${away.id}",
          "expect": {
            "status": 200
          }
        },
        {
          "as": "carol",
          "method": "GET",
          "path": "/teams/t-${run}",
          "expect": {
            "status": 200,
            "json": {
              "role": "member"
            }
          }
        },
        {
          "as": "alice",
          "method": "GET",
          "path": "/teams/t-${run}/members",
          "expect": {
            "status": 200,
            "itemsExactly": [
              "alice",
              "carol"
            ]
          }
        }
      ]
    },
    {
