     "path": "/teams/team-red/notes",
     "body": {
      "title": "Standup ${run}",
      "body": "agenda"
     },
     "expect": {
      "status": 201,
      "json": {
       "teamId": "team-red",
       "authorId": "alice",
       "title": "Standup ${run}",
       "body": "agenda",
       "version": 1
      }
     },
     "save": "n"
    },
    {
     "as": "alice",
     "method": "GET",
     "path": "/notes/${n.id}",
     "expect": {
      "status": 200,
      "json": {
       "id": "${n.id}",
       "title": "Standup ${run}"
      }
     }
    }
   ]
