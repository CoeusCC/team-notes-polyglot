{
 "$comment": "Data-only conformance cases. Each case falsifies one AC alias from spec/acceptance-criteria.md. Steps: as=<seed user> | token=<raw>, method, path, body | rawBody (<repeat:N:c> expands), expect {status, headers, json (deep subset), itemsContain, itemsLack, itemsExactly, errorFields}, save=<var>. ${var.path} interpolates; ${run} is a per-case random suffix.",
 "tokens": {
  "alice": "tok_alice",
  "bob": "tok_bob",
  "carol": "tok_carol"
 },
 "cases": [
  {
   "id": "health-open",
   "falsifies": "NOTES-SEC-AUTHN-1",
   "steps": [
    {
     "method": "GET",
     "path": "/health",
     "expect": {
      "status": 200,
      "json": {
       "status": "ok"
      }
     }
    }
   ]
  },
  {
   "id": "authn-missing-token",
   "falsifies": "NOTES-SEC-AUTHN-1",
   "steps": [
    {
     "method": "GET",
     "path": "/me",
     "expect": {
      "status": 401,
      "headers": {
       "content-type": "application/problem+json"
      }
     }
    },
    {
     "method": "GET",
     "path": "/teams",
     "expect": {
      "status": 401
     }
    },
    {
     "method": "GET",
     "path": "/teams/team-red/notes",
     "expect": {
      "status": 401
     }
    },
    {
     "method": "POST",
     "path": "/teams/team-red/notes",
     "body": {
      "title": "x"
     },
     "expect": {
      "status": 401
     }
    }
   ]
  },
